          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  coalesce(agentgateway_user, 'unknown')  AS \"User\",\n  gen_ai_request_model                    AS \"Model\",\n  count(*)                                AS \"Requests\",\n  sum(coalesce(input_tokens, 0))          AS \"Input tokens\",\n  sum(coalesce(output_tokens, 0))         AS \"Output tokens\"\nFROM request_logs\nWHERE $__timeFilter(completed_at) AND gen_ai_request_model IS NOT NULL\nGROUP BY 1, 2\nORDER BY 5 DESC",
          "refId": "A"
        }
      ]
