      "transformations": [],
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "agentgateway-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  gen_ai_request_model                                              AS \"Model\",\n  count(*)                                                          AS \"Requests\",\n  count(DISTINCT agentgateway_user)                                 AS \"Users\",\n  sum(coalesce(input_tokens, 0))                                    AS \"Input tokens\",\n  sum(coalesce(output_tokens, 0))                                   AS \"Output tokens\",\n  avg(time_to_first_token_ms)                                       AS \"Avg TTFT\",\n  avg(duration_ms)                                                  AS \"Avg duration\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms)         AS \"p95 duration\",\n  count(*) FILTER (WHERE http_status >= 400 OR error IS NOT NULL)   AS \"Errors\",\n  max(completed_at)                                                 AS \"Last request\"\nFROM request_logs\nWHERE $__timeFilter(completed_at) AND gen_ai_request_model IS NOT NULL\nGROUP BY 1\nORDER BY 2 DESC",
          "refId": "A"
        }
      ]
    },
