          "rawSql": "SELECT\n  completed_at                             AS \"Time\",\n  coalesce(agentgateway_user, 'unknown')   AS \"User\",\n  gen_ai_request_model                     AS \"Model\",\n  http_status                              AS \"Status\",\n  duration_ms                              AS \"Duration\",\n  time_to_first_token_ms                   AS \"TTFT\",\n  input_tokens                             AS \"Input\",\n  output_tokens                            AS \"Output\",\n  user_agent_name                          AS \"Client\",\n  error                                    AS \"Error\"\nFROM request_logs\nWHERE $__timeFilter(completed_at)\nORDER BY completed_at DESC\nLIMIT 100",
