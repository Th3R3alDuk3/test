      "panels": []
    },
    {
      "type": "stat",
      "title": "agentgateway",
      "description": "Whether Prometheus reaches the agentgateway metrics endpoint.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"agentgateway\"}",
          "legendFormat": "agentgateway",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "MCP endpoint",
      "description": "Share of /mcp requests without a 5xx in the last 5 minutes, for all MCP servers together: agentgateway reports MCP failures (500 reason MCP) on the virtual endpoint, not per server.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "NO TRAFFIC",
                  "color": "#8e8e8e",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO TRAFFIC",
                  "color": "#8e8e8e",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.99,
                "to": 1,
                "result": {
                  "text": "OK",
                  "color": "green",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.9,
                "to": 0.99,
                "result": {
                  "text": "DEGRADED",
                  "color": "yellow",
                  "index": 3
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.9,
                "result": {
                  "text": "FAILING",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "noValue": "no requests since agentgateway started"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum (rate(agentgateway_requests_total{listener=\"mcp\",status!~\"5..\"}[5m])) or sum (rate(agentgateway_requests_total{listener=\"mcp\"}[5m])) * 0) / sum (rate(agentgateway_requests_total{listener=\"mcp\"}[5m]))",
          "legendFormat": "MCP",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
