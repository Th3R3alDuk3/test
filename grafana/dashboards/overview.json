    {
      "title": "Gateway Internals",
      "type": "link",
      "url": "/d/agentgateway-standalone",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
