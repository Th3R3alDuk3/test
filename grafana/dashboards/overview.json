      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Status",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "agentgateway",
      "description": "Whether Prometheus reaches the agentgateway metrics endpoint.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"agentgateway\"}",
          "legendFormat": "agentgateway",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "LLM backends",
      "description": "One tile per model, as agentgateway sees its backend: share of requests without a 5xx in the last 5 minutes. OK >= 99 %, DEGRADED >= 90 %, FAILING below. A stopped backend shows up as 503 UpstreamFailure. NO TRAFFIC = no requests in the last 5 minutes.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 14,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "NO TRAFFIC",
                  "color": "#8e8e8e",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "NO TRAFFIC",
                  "color": "#8e8e8e",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.99,
                "to": 1,
                "result": {
                  "text": "OK",
                  "color": "green",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.9,
                "to": 0.99,
                "result": {
                  "text": "DEGRADED",
                  "color": "yellow",
                  "index": 3
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.9,
                "result": {
                  "text": "FAILING",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "noValue": "no requests since agentgateway started"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace((sum by (backend) (rate(agentgateway_requests_total{protocol=\"llm\",backend=~\"/llm:model:.+\",status!~\"5..\"}[5m])) or sum by (backend) (rate(agentgateway_requests_total{protocol=\"llm\",backend=~\"/llm:model:.+\"}[5m])) * 0) / sum by (backend) (rate(agentgateway_requests_total{protocol=\"llm\",backend=~\"/llm:model:.+\"}[5m])), \"model\", \"$1\", \"backend\", \"/llm:model:(.+):[0-9]+\")",
          "legendFormat": "{{model}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "links": [
        {
          "title": "Open LLM Overview",
          "url": "/d/llm-overview/llm-overview?${__url_time_range}"
        }
      ]
    },
    {
