    "agentgateway",
    "llm",
    "mcp"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "LLM Overview",
      "type": "link",
      "url": "/d/llm-overview/llm-overview",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "MCP Overview",
      "type": "link",
      "url": "/d/mcp-overview/mcp-overview",
      "icon": "dashboard",
      "keepTime": true
