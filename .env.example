# Copy to .env and fill in the secrets:
#   cp .env.example .env
# Generate secrets e.g. with: openssl rand -hex 32

# --- Images ----------------------------------------------------------------
# vllm-omni v0.32.0 ships vLLM 0.32.0 (Qwen3.5 support); vllm/vllm-openai:v0.32.0 works the same way.
VLLM_IMAGE=vllm/vllm-omni:v0.32.0
AGENTGATEWAY_IMAGE=cr.agentgateway.dev/agentgateway:v1.7.0
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.0
CODEBOX_IMAGE=ghcr.io/th3r3alduk3/owui-codebox-mcp:latest
CODEBOX_SANDBOX_IMAGE=ghcr.io/th3r3alduk3/owui-codebox-sandbox:latest

# --- vLLM --------------------------------------------------------------------
# Hugging Face cache that already holds the model
HF_CACHE_DIR=${HOME}/.cache/huggingface
VLLM_MODEL=Qwen/Qwen3.5-0.8B
# model name in vLLM, agentgateway and OpenWebUI
VLLM_MODEL_NAME=qwen3.5-0.8b
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.35
# default without thinking; requests can set chat_template_kwargs.enable_thinking
VLLM_ENABLE_THINKING=false

# --- agentgateway -------------------------------------------------------------
AGW_LLM_PORT=4000
AGW_MCP_PORT=3000
AGW_ADMIN_PORT=15000
# API key for the LLM port; OpenWebUI uses it too
AGW_LLM_API_KEY=
# encrypts MCP session tokens
AGW_SESSION_KEY=

# --- Postgres (agentgateway request logs + UI config) -------------------------
POSTGRES_DB=agentgateway
POSTGRES_USER=agentgateway
POSTGRES_PASSWORD=
# read-only role for Grafana
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=

# --- Open WebUI ---------------------------------------------------------------
OWUI_PORT=8081
OWUI_PUBLIC_URL=http://localhost:8081
# admin account created on the first start
OWUI_ADMIN_EMAIL=admin@example.com
OWUI_ADMIN_PASSWORD=
# also the JWT secret of codebox
WEBUI_SECRET_KEY=

# --- codebox --------------------------------------------------------------------
CODEBOX_MAX_CONCURRENT_SANDBOXES=10
# per microVM: MiB, vCPUs
CODEBOX_SANDBOX_MEMORY=2048
CODEBOX_SANDBOX_CPUS=2

# --- Monitoring -----------------------------------------------------------------
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
